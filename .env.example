# ─── Required ────────────────────────────────────────
# Admin authentication token for protected API routes (generate: openssl rand -base64 32)
ADMIN_TOKEN=your-secure-admin-token-here

# Static token auth is DISABLED by default. Set to "true" only if external
# tooling needs bearer-token access to admin APIs.
ALLOW_ADMIN_TOKEN=false

# NextAuth.js session encryption secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Set to "true" ONLY when behind a trusted reverse proxy (Vercel, Nginx,
# Cloudflare). If false, x-forwarded-for headers are ignored for rate limiting.
# NOTE: leaving this "false" behind a proxy means every visitor shares ONE
# global rate-limit bucket; leaving it "true" with direct-to-origin access
# lets attackers spoof IPs via x-forwarded-for. Match it to your topology.
TRUST_PROXY=false

# ─── Checkout fraud controls ─────────────────────────
# Sanity ceiling for a single order total, in the store currency. Orders whose
# DB-verified total exceeds this are rejected. 0 or empty disables the check.
MAX_ORDER_TOTAL=5000

# ─── Database (PostgreSQL) ───────────────────────────
# Credentials used by the `postgres` service in docker-compose.yml and by
# Prisma locally (host machine connects through 127.0.0.1:5432).
# Generate a strong password with: openssl rand -base64 24
POSTGRES_USER=izzan
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=izzan
DATABASE_URL=postgresql://izzan:change-me-to-a-strong-password@localhost:5432/izzan

# ─── Admin Seeding (required for first setup) ────────
# Set these to create an admin account during `prisma db seed`
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-to-a-strong-password

# ─── Redis (distributed rate limiting) ────────────────
# Optional. When REDIS_URL is set, rate limiting is shared across instances.
# Supported URL schemes:
#   https://…   → Upstash REST API (also set REDIS_TOKEN)
#   redis://…   → native Redis protocol, e.g. docker-compose redis service
#                 (REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379; no token)
# Leave unset to use the in-memory per-instance fallback.
REDIS_URL=
REDIS_TOKEN=

# ─── Media uploads ─────────────────────────────────────
# "local"  → files stored on disk under public/uploads (default; VPS/Docker)
# "vercel" → files stored in Vercel Blob; requires BLOB_READ_WRITE_TOKEN
#            (auto-injected by Vercel when a Blob store is connected).
STORAGE_PROVIDER=local
BLOB_READ_WRITE_TOKEN=

# ─── Backups ──────────────────────────────────────────
# Passphrase used to encrypt backup archives (scripts/backup.sh)
BACKUP_PASSPHRASE=change-me-to-a-strong-passphrase

# ─── Optional (future integrations) ─────────────────
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
